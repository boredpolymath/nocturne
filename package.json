{
  "name": "nocturne",
  "version": "1.0.4",
  "description": "Project Nocturne (MK-IV) — Ambient Workstation Poltergeist Daemon & Paranormal Telemetry Unit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:macos-arm64": "tauri build --target aarch64-apple-darwin",
    "build:macos-x64": "tauri build --target x86_64-apple-darwin",
    "build:windows-x64": "tauri build --target x86_64-pc-windows-msvc",
    "build:linux-x64": "tauri build --target x86_64-unknown-linux-gnu",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all -- --check",
    "audit:supply-chain": "cargo audit && cargo deny check advisories bans licenses sources",
    "release:integrity": "python3 scripts/generate_release_integrity.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
